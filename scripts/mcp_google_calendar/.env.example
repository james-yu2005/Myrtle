# From xiaozhi.me console → your agent → MCP endpoint.
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=YOUR_TOKEN_HERE

# OAuth 2.0 Desktop client from Google Cloud Console (Calendar API enabled).
# Either set both IDs below, or place credentials.json in this folder.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: path to downloaded OAuth client JSON (overrides GOOGLE_CLIENT_* if set).
# GOOGLE_OAUTH_CLIENT_SECRET=credentials.json

# Calendar to read/write (default: primary Google Calendar).
GOOGLE_CALENDAR_ID=primary

# IANA timezone for events without an explicit offset (e.g. America/New_York).
GOOGLE_CALENDAR_TIMEZONE=America/New_York
